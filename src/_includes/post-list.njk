<ul class="post-list">
  {%- for post in items %}
  <li>
    <time datetime="{{ post.date | isoDate }}">{{ post.date | readableDate }}</time>
    <a href="{{ post.url }}">{{ post.data.title }}</a>{% if post.data.draft %} <span class="draft">Draft</span>{% endif %}
    {%- if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
  </li>
  {%- endfor %}
</ul>
