---
layout: base.njk
---
<article class="post">
  <header>
    <p class="meta"><time datetime="{{ page.date | isoDate }}">{{ page.date | readableDate }}</time>{% if draft %} · <span class="draft">Draft, not published</span>{% endif %}</p>
    <h1>{{ title }}</h1>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
  <p class="back"><a href="/blog/">&larr; All posts</a></p>
</article>
